    "            row[f\"rho {variable}\"] = stats.spearmanr(valid[factor], valid[variable]).statistic\n",
    "        rows.append(row)\n",
    "    factor_meaning = pd.DataFrame(rows).set_index(\"factor\")\n",
    "    display(factor_meaning.round(3))\n",
