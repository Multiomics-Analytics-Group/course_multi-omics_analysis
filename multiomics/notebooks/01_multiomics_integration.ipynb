    "    for factor in factor_cols:\n",
    "        row = {\"factor\": factor}\n",
    "        kruskal = stats.kruskal(*[factors.loc[factors[\"group\"] == g, factor] for g in GROUP_ORDER])\n",
    "        row[\"p (group difference)\"] = kruskal.pvalue\n",
